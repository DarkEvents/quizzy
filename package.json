{
	"name": "telegram-typescript-bot-template",
	"private": true,
	"version": "0.0.0",
	"description": "",
	"keywords": [
		""
	],
	"license": "MIT",
	"repository": "<%= githubUsername %>/telegram-typescript-bot-template",
	"author": {
		"name": "<%= name %>",
		"email": "<%= email %>",
		"url": "<%= website %>"
	},
	"scripts": {
		"copy-key": "cp -r package.json resources source/bot/bot-token.txt dist/",
		"copy-key-dev": "cp source/bot/bot-token-dev.txt dist/source/bot/bot-token.txt",
		"build": "del-cli dist && tsc",
		"build-es": "esbuild ./source/index.ts --keep-names --bundle --platform=node --outfile=dist/main.js --format=cjs && npm run copy-key",
		"prepack": "npm run build",
		"start": "npm run copy-key && tsc && node -r source-map-support/register dist/source/index.js",
		"dev": "npm run copy-key-dev && tsc --sourceMap --watch & nodemon --unhandled-rejections=strict -r source-map-support/register -w dist dist/source/index.js",
		"pm2start": "pm2 start node --name 'Quizzy' --  main.js ",
		"pm2stop": "pm2 stop 'Quizzy'",
		"pm2delete": "pm2 delete 'Quizzy'",
		"pm2restart": "pm2 restart 'Quizzy'",
		"test": "tsc --sourceMap && xo && nyc ava"
	},
	"engines": {
		"node": ">=14"
	},
	"dependencies": {
		"@edjopato/telegraf-i18n": "^0.2.1",
		"axios": "^0.21.1",
		"jimp": "^0.22.8",
		"mysql2": "^3.3.3",
		"source-map-support": "^0.5.19",
		"telegraf": "^4.12.2",
		"telegraf-inline-menu": "^6.2.0",
		"telegraf-session-local": "^2.1.0"
	},
	"devDependencies": {
		"@sindresorhus/tsconfig": "^0.8.0",
		"@types/node": "^14.14.35",
		"ava": "^5.3.0",
		"cross-env": "^10.1.0",
		"nyc": "^15.0.0",
		"typescript": "^4.2.3",
		"xo": "^0.44.0"
	},
	"files": [
		"dist/source",
		"!*.test.*"
	],
	"main": "dist/source",
	"types": "dist/source",
	"nyc": {
		"all": true,
		"extension": [
			".ts"
		],
		"include": [
			"dist/source",
			"source"
		],
		"exclude": [
			"**/*.d.ts",
			"**/*.test.ts"
		],
		"reporter": [
			"lcov",
			"text"
		]
	},
	"xo": {
		"rules": {
			"ava/no-ignored-test-files": "off"
		}
	}
}
